roup", "contents": [{"content": "Activity 3", "type": "group_name"}]}, {"content": {"correct_feedback": "Parfait !", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Quelque chose ne va pas. Essayez encore une fois !", "type": "text"}, {"content": "La prochaine fois peut-\u00eatre.", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Consignes :  <span class = \"bullet\">Lisez les phrases suivantes.</span>  <span class = \"bullet\">Remplissez les blancs avec les mots manquants.</span>  <span class = \"bullet\">Employez <span class=\"product-color-text\">combien co\u00fbte</span>, <span class=\"product-color-text\">c'est combien</span>, <span class=\"product-color-text\">ils sont \u00e0</span>.<span class = \"bullet\">Employez une lettre majuscule si n\u00e9cessaire.</span><span class = \"bullet\">Enregistrez-vous en disant les m\u00eames phrases \u00e0 voix haute</span>.<span class = \"bullet\">V\u00e9rifiez votre prononciation avec votre professeur.</span>", "type": "text"}, {"content": " Vous avez deux essais pour soumettre vos r\u00e9ponses.", "type": "text"}]}], "type": "TYP", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "frn2le04ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:      Excusez-moi monsieur, pourriez-vous m'indiquer o\u00f9 se trouvent les patates&nbsp;?<br />\n<span class=\"strong\">Le vendeur </span>:      Certainement, elles sont l\u00e0-bas.", "id": 1, "time": "100", "image": "frn2le04ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:      Merci monsieur. Combien co\u00fbte le brocoli bio&nbsp;? <br />\n<span class=\"strong\">Le vendeur </span>:      2,50 \u20ac la botte.", "id": 2, "time": "5500", "image": "frn2le04ob09re2img02.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:     Merci. Et combien pour une botte de chou-fleur&nbsp;? <br />\n<span class=\"strong\">Le vendeur </span>:      \u00c7a co\u00fbte 3 \u20ac.", "id": 3, "time": "10000", "image": "frn2le04ob09re2img02.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:      Regarde, il y a deux types de patates l\u00e0-bas&nbsp;!<br />\n<span class=\"strong\">Pierre </span>: Combien \u00e7a co\u00fbte&nbsp;? <br />\n<span class=\"strong\">Coraline</span>:      Celles-ci sont \u00e0 2 \u20ac le kilo. Celles-l\u00e0 sont \u00e0 2,50 \u20ac le kilo.<br />\n<span class=\"strong\">Pierre </span>: Pas mal quand m\u00eame.", "id": 4, "time": "15000", "image": "frn2le04ob09re2img01.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:      Pardon monsieur, o\u00f9 se trouvent les oignons&nbsp;?<br />\n<span class=\"strong\">Le vendeur </span>:      L\u00e0-bas ! Les oignons rouges co\u00fbtent 2 \u20ac le kilo et les oignons verts co\u00fbtent 3 \u20ac le kilo.", "id": 5, "time": "26000", "image": "frn2le04ob09re2img02.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:      Super ! Avez-vous des haricots jaunes&nbsp;?<br />\n<span class=\"strong\">Le vendeur </span>:     D\u00e9sol\u00e9 mademoiselle. On n'a plus de haricots jaunes.", "id": 6, "time": "34500", "image": "frn2le04ob09re2img05.jpg"}, {"text": "<span class=\"strong\">Coraline </span>:    Pierre, peux-tu m'apporter de l'ail&nbsp;?<br />\n<span class=\"strong\">Pierre </span>: D'accord. Je reviens tout de suite.", "id": 7, "time": "40250", "image": "frn2le04ob09re2img02.jpg"}], "audiosrc": "frn2le04ob09re2aud01", "coverimg": "frn2le04ob09re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}